# 複製成 .env 後再填值。.env 絕對不可以 commit。

# 地端模型（Ollama 裝在電腦上，不在 Docker 裡）
OLLAMA_URL=http://host.docker.internal:11434
# 3B 以下皆可；電腦較弱建議 qwen2.5:1.5b
LOCAL_MODEL=qwen2.5:3b

# 檢索版本：A＝基本版（段落切塊＋bge-m3 向量檢索）；B＝改良版（A＋BM25 字元二元組，以 RRF 合併）
# 其餘實驗用設定見 api/app/retrieval.py 的 PRESETS
RETRIEVER_VERSION=A
# 每次檢索取幾個切塊
RETRIEVER_K=3
# 嵌入模型來源：ollama（Docker 內使用，需先 ollama pull bge-m3）；st 僅供本機實驗
EMBED_BACKEND=ollama

# 問題分流：rule（預設，關鍵字）／llm（小模型直接分類）／fields（小模型列出需要的資訊再對照）／off（不分流）
ROUTER_MODE=rule
# llm／fields 分類用的模型
ROUTER_MODEL=qwen2.5:3b
# 閒聊回覆用的小模型
CHAT_MODEL=qwen2.5:0.5b

# 與校務文件的最高相似度低於此值、且沒有查到成績時，直接回答「不知道」（依 docs/honesty-experiments.md 實測決定）
NO_ANSWER_SIM=0.40

# Python 課程彙總資料（不是助教提供的資料）：0＝關閉（預設）、1＝開啟
ENABLE_COURSE=0

# 雲端 API 的 key（用哪一家自己決定，變數名稱也可以改）
CLOUD_API_KEY=
